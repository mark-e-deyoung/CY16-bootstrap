{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-e-deyoung/CY16-bootstrap/spec/cy16-scan-artifact-v1.schema.json",
  "title": "CY16 SCAN Artifact Manifest v1",
  "description": "Machine-readable handoff contract for a raw CY16 binary and its Cypress SCAN image.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "artifact_kind",
    "target",
    "execution_model",
    "byte_order",
    "producer",
    "image",
    "records",
    "required_loader_features",
    "constraints",
    "warnings",
    "provenance_notes"
  ],
  "properties": {
    "schema": {
      "const": "cy16-scan-artifact/v1"
    },
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "cy16-scan-image"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "device"],
      "properties": {
        "family": {
          "const": "C67x00"
        },
        "device": {
          "enum": ["CY7C67200", "CY7C67300"]
        }
      }
    },
    "execution_model": {
      "enum": ["bios-cooperative", "standalone", "unknown"]
    },
    "byte_order": {
      "const": "little"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tool", "version"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tool": {
          "const": "cy16-scan-manifest"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["load_address", "entry_point", "raw_binary", "scan"],
      "properties": {
        "load_address": {
          "$ref": "#/$defs/wordAddress"
        },
        "entry_point": {
          "$ref": "#/$defs/wordAddress"
        },
        "raw_binary": {
          "$ref": "#/$defs/fileDescriptor"
        },
        "scan": {
          "$ref": "#/$defs/fileDescriptor"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "required_loader_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "$ref": "#/$defs/stringArray"
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    },
    "provenance_notes": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "wordAddress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "multipleOf": 2
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "offset",
        "opcode",
        "name",
        "encoded_length",
        "record_size",
        "address",
        "payload_size",
        "payload_sha256"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "opcode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "encoded_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "record_size": {
          "type": "integer",
          "minimum": 6,
          "maximum": 65540
        },
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "payload_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "opcode": {
                "const": 9
              }
            },
            "required": ["opcode"]
          },
          "then": {
            "required": ["config_offset", "value"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["config_offset"]},
                {"required": ["value"]}
              ]
            }
          }
        }
      ]
    }
  }
}
